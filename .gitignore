# ==========================================
# 1. Dados e Arquivos Grandes (Crucial)
# ==========================================
# Ignora a pasta de dados brutos para não vazar informações de clientes
data/
*.csv
*.xlsx
*.parquet

# Ignora os arquivos gigantes gerados pelo seu script do SHAP
shap/out/

# Ignora o modelo treinado (se for muito pesado)
*.joblib
*.pkl
*.model

# ==========================================
# 2. Python e Ambientes Virtuais
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# ==========================================
# 3. Streamlit e Jupyter Notebooks
# ==========================================
# Ignora arquivos de checkpoint do Jupyter
.ipynb_checkpoints/

# Ignora credenciais ou configurações locais do Streamlit
.streamlit/secrets.toml

